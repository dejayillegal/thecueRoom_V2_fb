# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cron Security (for external cron services)
CRON_SECRET=your-secret-key-here

# Admin Security (for admin panel access)
ADMIN_SECRET=your-admin-secret-here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/thecueroom
DIRECT_URL="postgresql://user:pass@host:5432/db"

# AI Configuration
# OpenAI (for EPK text generation - GPT-4o - BEST for creative writing)
OPENAI_API_KEY=
# Perplexity (for EPK text generation - good for factual content)
PERPLEXITY_KEY=
# Hugging Face (for Stable Diffusion XL & text generation fallback)
HF_API_TOKEN=optional
HF_TOKEN=optional
HUGGINGFACE_KEY=your_hf_key_here
# Google Gemini (for image generation)
GOOGLE_API_KEY=optional
GEMINI_API_KEY=optional

# AI System Configuration
LOCAL_DIFFUSERS=false
VERIFY_TEMP_DIR=/tmp/thecueroom/verify
AI_WORKER_CONCURRENCY=1
POLL_INTERVAL_SECONDS=60
POLL_CONCURRENCY=3
FEED_FAILURE_THRESHOLD=5
PDF_RENDERER=pdf-lib
TEST_MODE=false

# Ticketing
TICKET_SECRET=your-hmac-secret-change-in-production

# Optional: Redis for job queue (falls back to in-memory)
REDIS_URL=

# SoundCloud (Optional - mock data available)
SOUNDCLOUD_CLIENT_ID=

# Admin Credentials (for seeding)
# These are used during setup to create the admin user
# Note: Never commit actual passwords to version control
# Use ADMIN_PASSWORD_HASH for seeding, or set ADMIN_PASSWORD only in local .env (not .env.example)
ADMIN_EMAIL=dejayillegal@gmail.com
ADMIN_PASSWORD_HASH=

# Ingestion
INGESTION_HMAC_SECRET=your_random_secret_here

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:5000

# Model Worker (for local AI generation)
MODEL_WORKER_URL=http://localhost:8001

# Cron Job Configuration
CRON_SECRET=your-super-secret-random-string-min-32-chars
ADMIN_SECRET=your-admin-secret-here

# Periodic Ingest Configuration (in minutes)
# Default: 60 (1 hour)
# Minimum recommended: 15 (to avoid rate limiting)
INGEST_INTERVAL_MINUTES=15

# Feed Poller Configuration (for robust feed polling system)
POLL_INTERVAL_SECONDS=60
POLL_CONCURRENCY=3
FEED_FAILURE_THRESHOLD=5

# Fallback thumbnail configuration
FALLBACK_WORKER_CONCURRENCY=2
FALLBACK_CACHE_TTL_HRS=168
ENABLE_FALLBACK_ROTATION=false

# EPK Generator Configuration
EPK_TEMP_DIR=/tmp/thecueroom-epk
EPK_WORKER_CONCURRENCY=1
EPK_TEST_MODE=false
EPK_PDF_TOOL=puppeteer
PDF_RENDERER=pdf-lib

# Authentication & Session
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:5000"
JWT_SECRET=your-jwt-secret-key-change-this-in-production-use-at-least-32-characters
SESSION_SECRET=your-session-secret-change-this-in-production

# Rate Limiting (for login attempts)
RATE_LIMIT_WINDOW=60        # seconds
RATE_LIMIT_POINTS=5          # max attempts per window

# AI Verification Confidence
AI_VERIFICATION_CONFIDENCE=0.9  # 0.0 to 1.0, threshold for auto-approval

# AI Services
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Gigs Poller Configuration
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_CONCURRENCY=1
PLAYWRIGHT_HEADLESS_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage
HEADLESS_THRESHOLD=10
POLL_INTERVAL_SECONDS=300
POLL_CONCURRENCY=3
POLL_RETRY_ATTEMPTS=2
NODE_FETCH_TIMEOUT_MS=15000
FEEDS_CACHE_TTL_SECONDS=600
FEEDS_CACHE_PATH=.local/feeds-cache
FEED_USER_AGENT="thecueRoomBot/2.0 (+https://thecueroom.com)"
USE_PROXY_FOR_SCRAPING=false
SCRAPING_PROXY_URL=

# Feature Flags
TEST_MODE=false