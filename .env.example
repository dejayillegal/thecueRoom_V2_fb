# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cron Security (for external cron services)
CRON_SECRET=your-secret-key-here

# Admin Security (for admin panel access)
ADMIN_SECRET=your-admin-secret-key-here

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# AI Services (Optional - local fallbacks available)
OPENAI_API_KEY=
REPLICATE_API_KEY=

# SoundCloud (Optional - mock data available)
SOUNDCLOUD_CLIENT_ID=

# Admin Credentials (for seeding)
# These are used during setup to create the admin user
# Note: Never commit actual passwords to version control
# Use ADMIN_PASSWORD_HASH for seeding, or set ADMIN_PASSWORD only in local .env (not .env.example)
ADMIN_EMAIL=dejayillegal@gmail.com
ADMIN_PASSWORD_HASH=

# Ingestion
INGESTION_HMAC_SECRET=your_random_secret_here

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:5000

# AI Features (Optional - uses TEST_MODE with fixtures when not provided)
HF_API_TOKEN=
LOCAL_DIFFUSERS=false
TEST_MODE=true

# Ticketing Security (for free ticket HMAC verification)
TICKET_SECRET=your-hmac-secret-change-this-in-production

# Model Worker (for local AI generation)
MODEL_WORKER_URL=http://localhost:8001