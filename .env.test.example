
# Test Environment Variables

# Database
DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/thecueroom_test
SUPABASE_URL=https://test.supabase.co
SUPABASE_ANON_KEY=test_anon_key
SUPABASE_SERVICE_KEY=test_service_key

# Auth
SESSION_SECRET=test_session_secret_min_32_chars
NEXTAUTH_SECRET=test_nextauth_secret

# External APIs (use sandbox/test accounts)
OPENAI_API_KEY=sk-test-key
SPOTIFY_CLIENT_ID=test_client_id
SPOTIFY_CLIENT_SECRET=test_client_secret

# Storage
UPLOAD_BUCKET=test-uploads

# Email (use test provider)
EMAIL_FROM=test@thecueroom.com
EMAIL_SMTP_HOST=smtp.test.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=test_user
EMAIL_SMTP_PASS=test_pass

# Feature Flags
TEST_MODE=true
ENABLE_AI=false
ENABLE_ANALYTICS=false

# Load Testing
LOAD_TEST_BASE_URL=http://localhost:5000
LOAD_TEST_VUS=50
LOAD_TEST_DURATION=5m
