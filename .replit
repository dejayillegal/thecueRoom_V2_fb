modules = ["nodejs-18", "web", "nix", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_openai:1.0.0"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Background Worker"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "EPK Worker"

[[workflows.workflow]]
name = "Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter web dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Background Worker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm worker"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "EPK Worker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node packages/epk/worker.mjs"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 41663
externalPort = 3000

[[ports]]
localPort = 42093
externalPort = 3002

[[ports]]
localPort = 42433
externalPort = 3001

[[ports]]
localPort = 43155
externalPort = 3003
