modules = ["nodejs-18", "web", "bash", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_openai:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["vim-full"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow]]
name = "Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter web dev --port 5000"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.development]
TEST_MODE = "true"
VERIFY_TEMP_DIR = "/tmp/thecueroom/verify"
AI_WORKER_CONCURRENCY = "1"

[deployment]
deploymentTarget = "autoscale"
run = ["pnpm", "--filter", "web", "start"]
build = ["pnpm", "--filter", "web", "build"]
