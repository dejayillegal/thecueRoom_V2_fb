modules = ["nodejs-18", "web", "bash", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_openai:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["vim-full"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow]]
name = "Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter web dev --port 5000 --host 0.0.0.0"
waitForPort = 5000

[[workflows.workflow]]
name = "Initialize Database"
author = 49233828
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "tsx scripts/init-all.ts"

[[workflows.workflow]]
name = "Seed Forum Data"
author = 49257534
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "tsx scripts/seed-forum-data.ts"

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.development]
TEST_MODE = "true"
VERIFY_TEMP_DIR = "/tmp/thecueroom/verify"
AI_WORKER_CONCURRENCY = "1"
