{
  "name": "thecueroom-v2",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "migrate": "pnpm --filter db migrate",
    "migrate:generate": "pnpm --filter db migrate:generate",
    "ingest": "tsx scripts/enhanced-ingest.ts",
    "ingest:all": "tsx scripts/ingest-all.ts",
    "ingest:enhanced": "tsx scripts/enhanced-ingest.ts",
    "seed:sources": "tsx scripts/seed-sources.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "setup": "tsx scripts/setup.ts",
    "worker": "tsx scripts/start-worker.ts",
    "worker:dev": "tsx watch scripts/start-worker.ts",
    "ai:worker": "pnpm --filter worker ai",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean",
    "create-admin": "tsx scripts/create-admin-user.ts"
  },
  "postinstall": "echo '\n✨ Run \"pnpm setup\" to initialize the database and fetch feeds'",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@playwright/test": "^1.56.1",
    "@radix-ui/react-switch": "^1.2.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.6",
    "@vercel/og": "^0.8.5",
    "@vitest/ui": "^3.2.4",
    "bcryptjs": "^3.0.2",
    "bottleneck": "^2.19.5",
    "cheerio": "1.0.0-rc.12",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "^0.36.4",
    "got": "^14.6.1",
    "happy-dom": "^17.6.1",
    "jose": "^6.1.0",
    "msw": "^2.11.6",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.17.2",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "postgres": "^3.4.7",
    "puppeteer-core": "^24.26.1",
    "qrcode": "^1.5.4",
    "rss-parser": "3.12.0",
    "sharp": "^0.34.4",
    "undici": "^7.16.0",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.23",
    "tsx": "^4.20.6"
  }
}
