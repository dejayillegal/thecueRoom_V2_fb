{
  "name": "thecueroom-v2",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "migrate": "pnpm --filter db migrate",
    "migrate:generate": "pnpm --filter db migrate:generate",
    "ingest": "pnpm --filter worker ingest",
    "ai:worker": "pnpm --filter worker ai",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.7",
    "rss-parser": "3.12.0"
  }
}
