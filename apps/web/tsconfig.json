{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./components/*", "./src/components/*"],
      "@/lib/*": ["./lib/*", "./src/lib/*"],
      "@/app/*": ["./app/*"],
      "@/hooks/*": ["./hooks/*", "./src/hooks/*"],
      "@thecueroom/ai/*": ["../../packages/ai/*"],
      "@thecueroom/fallback/*": ["../../packages/fallback/*"],
      "@thecueroom/epk": ["../../packages/epk/index.ts"],
      "@thecueroom/epk/*": ["../../packages/epk/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}